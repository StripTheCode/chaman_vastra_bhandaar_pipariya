# ========================================================
# CHAMAN VASTRA BHANDAR PIPARIYA - ENVIRONMENT CONFIG
# ========================================================

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & JWT Security
JWT_SECRET=your_super_secret_jwt_key_here_chaman_2026

# Razorpay Payment Gateway (Test or Live Credentials)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Cloudinary Image & Media CDN
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Persistent Cloud Database (MongoDB Atlas / PostgreSQL)
# If omitted, local in-memory persistent JSON adapter is used automatically
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.chaman.mongodb.net/chaman_db?retryWrites=true&w=majority
